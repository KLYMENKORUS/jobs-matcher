# everything the image does not need; keeps the build context small and
# keeps secrets out of the image (.env is passed at runtime by compose)
.git
.gitignore
.env
*.env
.venv
.idea
.vscode
.mypy_cache
.ruff_cache
.pytest_cache
graphify-out
local
media
**/__pycache__
**/*.pyc
**/log_files
*.log
app/tests
app/docker
Dockerfile
.dockerignore
README.md
